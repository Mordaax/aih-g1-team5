# CX Agent Studio API access deployment
GCP_PROJECT_ID=aih-g1-team-5
GCP_REGION_ID=us
CX_API_VERSION=v1beta
CX_APPLICATION_ID=e223beb8-98d2-4543-be83-d539b0b86e6a
CX_DEPLOYMENT_ID=01493575-fb2d-4418-85bc-28b4099a6254

# Informational reference for the application version selected by the deployment.
# runSession resolves the active application version from CX_DEPLOYMENT_ID.
CX_APPLICATION_VERSION_ID=e4c99d0c-2cef-4493-97c4-106c434ce741

# MERaLiON speech-to-text. Keep this server-only.
MERALION_API_KEY=

# SEA-LION translation around the English-only CX session. Server-only.
SEALION_API_KEY=
SEALION_MODEL=aisingapore/Gemma-SEA-LION-v4-27B-IT

# Azure Speech: create a Speech resource with the Free (F0) pricing tier.
# Never prefix these with NEXT_PUBLIC_. The API key does not select the pricing tier.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Optional production override: JSON external-account / service-account
# credential configuration stored as a server-only Vercel environment variable.
# GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Preferred Vercel deployment authentication: Google Workload Identity Federation.
# Restrict the Google provider and service-account binding to this Vercel project.
# GCP_PROJECT_NUMBER=
# GCP_SERVICE_ACCOUNT_EMAIL=
# GCP_WORKLOAD_IDENTITY_POOL_ID=
# GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
